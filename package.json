    "leaflet": "1.9.4",
    "react-leaflet": "5.0.0",
    "lucide-react": "0.468.0",
    "i18next": "25.5.2",
    "react-i18next": "16.0.0",
    "zod": "4.1.11",
    "recharts": "3.2.1",
    "@radix-ui/react-dialog": "1.1.15"
  },
  "devDependencies": {
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@types/leaflet": "1.9.20",
    "@vitejs/plugin-react": "5.0.3",
