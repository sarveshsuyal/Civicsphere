# Browser: publishable credentials only. Copy frontend values to frontend/.env.local.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Server-side API. Never prefix server secrets with VITE_.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENROUTESERVICE_API_KEY=
GEOCODING_PROVIDER=nominatim
WEATHER_PROVIDER=open-meteo
AI_PROVIDER=
AI_API_KEY=
WORKER_API_URL=
WORKER_SECRET=
EMAIL_PROVIDER=
EMAIL_API_KEY=

# Separate GIS worker only. Never set this in a browser environment.
WORKER_SUPABASE_SERVICE_ROLE_KEY=
